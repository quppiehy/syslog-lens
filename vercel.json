{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".vercel-empty-output",
  "rewrites": [
    { "source": "/:path*", "destination": "/api?__path=:path*" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{syslog-lens.html,public/**}"
    }
  }
}
