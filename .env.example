# Copy this file to .env and adjust as needed.

# Port the Express server listens on.
PORT=3000

# Path to the SQLite database file (relative to the project root, or absolute).
DB_STORAGE=server/data/syslog-lens.sqlite

# Secret used to sign JWT auth tokens. Required — the server refuses to
# start without one, and it must be at least 32 characters long. Generate a
# strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-generated-secret-at-least-32-characters-long

# How long an issued JWT stays valid (jsonwebtoken `expiresIn` format).
JWT_EXPIRES_IN=8h
