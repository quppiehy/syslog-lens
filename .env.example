# Copy this file to .env and adjust as needed.

# Port the Express server listens on.
PORT=3000

# Path to the SQLite database file (relative to the project root, or absolute).
DB_STORAGE=server/data/syslog-lens.sqlite

# Secret used to sign JWT auth tokens. Required — the server refuses to
# start without one, and it must be at least 32 characters long. Generate a
# strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-generated-secret-at-least-32-characters-long

# How long an issued JWT stays valid (jsonwebtoken `expiresIn` format).
JWT_EXPIRES_IN=8h

# Whether the httpOnly auth cookie is marked Secure (only sent over HTTPS).
# Leave false for local development over plain http://localhost; set to
# true when running behind HTTPS in production (this also enables HSTS).
COOKIE_SECURE=false

# Invite code required to register (POST /api/auth/register body field
# `inviteCode`). Required in production (NODE_ENV=production) — the server
# refuses to start without one at least 12 characters long. Optional in
# dev/test: leave unset to skip the invite-code check entirely.
INVITE_CODE=replace-this-with-a-generated-invite-code-at-least-12-characters-long

# Express `trust proxy` setting (https://expressjs.com/en/guide/behind-proxies.html),
# used to derive the real client IP (req.ip) for rate limiting when running
# behind a reverse proxy. Leave false for local development. On Vercel (a
# single trusted edge proxy in front of the app) set this to 1.
TRUST_PROXY=false

# --- Login/register rate limiting (all values in milliseconds) ---
# Per employee number: lock out after this many failed logins within the
# window, for the lock duration.
LOGIN_EMP_MAX_ATTEMPTS=5
LOGIN_EMP_WINDOW_MS=900000
LOGIN_EMP_LOCK_MS=900000
# Per IP address: lock out after this many failed logins within the window.
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_MS=900000
LOGIN_IP_LOCK_MS=900000
# Per IP address: lock out registration after this many attempts within the
# window (regardless of whether each attempt succeeded).
REGISTER_IP_MAX_ATTEMPTS=10
REGISTER_IP_WINDOW_MS=3600000
REGISTER_IP_LOCK_MS=3600000
